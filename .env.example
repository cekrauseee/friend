# Server only. Never prefix these variables with VITE_.
# OpenAI voice/dictation and API conversation cognition use this key. Codex cognition does not.
OPENAI_API_KEY=

# Development text chat: codex (default) or api. Restart Vite after changing it.
# Set api explicitly for pnpm preview.
DOT_TEXT_PROVIDER=codex

# Dictation: openai (default when omitted) or elevenlabs. Restart Vite after changing it.
# Explicit blank or unknown provider values are invalid. No automatic fallback.
DOT_TRANSCRIPTION_PROVIDER=openai

# Real-time voice: openai (default) or elevenlabs. ElevenLabs uses DOT_TEXT_PROVIDER cognition.
DOT_VOICE_PROVIDER=openai

# Required for selected ElevenLabs dictation (Scribe v2) or Speech Engine voice.
# Independent of OPENAI_API_KEY; never sent to the browser.
ELEVENLABS_API_KEY=

# ElevenLabs voice only. Existing Speech Engine with eleven_v4_turbo and a voice.
# Configure its public WSS URL to forward only to the dedicated listener below:
# wss://your-ingress.example/speech-engine/upstream (never expose Vite/login APIs).
# Dot validates the engine and issues tokens; it never creates/edits remote engines.
ELEVENLABS_SPEECH_ENGINE_ID=

# Dedicated authenticated upstream listener, started only for ElevenLabs voice.
# Defaults are loopback:3001. Change host only when required by your ingress.
DOT_SPEECH_ENGINE_HOST=127.0.0.1
DOT_SPEECH_ENGINE_PORT=3001
