# Server only. Never prefix these variables with VITE_.
# OpenAI voice, OpenAI dictation and API text chat use this key. Codex text chat does not.
OPENAI_API_KEY=

# Development text chat: codex (default) or api. Restart Vite after changing it.
# Set api explicitly for pnpm preview.
DOT_TEXT_PROVIDER=codex

# Dictation: openai (default when omitted) or elevenlabs. Restart Vite after changing it.
# Explicit blank or unknown provider values are invalid. No automatic fallback.
DOT_TRANSCRIPTION_PROVIDER=openai

# Real-time voice: openai (default) or elevenlabs. Independent of text and dictation.
DOT_VOICE_PROVIDER=openai

# Required for selected ElevenLabs dictation (Scribe v2) or ElevenAgents voice.
# Independent of OPENAI_API_KEY; never sent to the browser.
ELEVENLABS_API_KEY=

# ElevenLabs voice only. Use an existing published ElevenAgents agent configured
# with eleven_v4_turbo and a native LLM served through ElevenLabs.
# Dot validates that configuration and pins its token to the published version;
# it never creates or edits hosted agents. Agent/account billing and retention apply.
# Enable audio, first-message interruptions, and these client events:
# user_transcript, agent_response, agent_response_correction, interruption.
# Workflows are unsupported; language presets must preserve the required configuration.
ELEVENLABS_AGENT_ID=
