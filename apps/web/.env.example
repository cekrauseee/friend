# Public browser API base. Empty keeps same-origin /api requests.
# Set an absolute HTTP(S) origin (optionally with a path prefix) for a separate API.
# The backend must allow the frontend origin for cross-origin requests.
VITE_API_BASE_URL=

# Vite dev and preview proxy target; this value is not exposed to browser code.
API_PROXY_TARGET=http://127.0.0.1:3000
